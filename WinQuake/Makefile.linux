# =============================================================================
# Linux Makefile for WinQuake — x86_64 (and x86) modern ports
#
# Targets:
#   quake.x11   — software renderer + X11 (XShm)
#   glquake     — OpenGL renderer + GLX / X11
#
# Usage (from repo root or WinQuake/):
#   make -f Makefile.linux -j$(nproc)
#   make -f Makefile.linux quake.x11
#   make -f Makefile.linux glquake
#   make -f Makefile.linux test
#
# Based on id Software Makefile.linuxi386 + community patches.
# =============================================================================

.PHONY: all clean distclean test tests verify quake.x11 glquake install \
        debug-x11 sanitize-x11

# -----------------------------------------------------------------------------
# Toolchain / flags
# -----------------------------------------------------------------------------

CC      ?= gcc
STD     ?= -std=gnu17

# Host arch
UNAME_M := $(shell uname -m)
ifeq ($(UNAME_M),x86_64)
  ARCH := x86_64
  MARCH ?= -march=x86-64-v3 -mtune=generic -mavx2 -mfma
else ifeq ($(UNAME_M),i686)
  ARCH := x86
  MARCH ?= -march=i686 -mtune=generic
else
  ARCH := $(UNAME_M)
  MARCH ?=
endif

# Paths
# DEBUG=1 / SANITIZE=... use separate build trees so objects never mix with -O3.
SRCDIR  := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROOTDIR := $(abspath $(SRCDIR)/..)
BUILD_VARIANT :=
ifdef DEBUG
  BUILD_VARIANT := $(BUILD_VARIANT)-dbg
endif
ifdef SANITIZE
  BUILD_VARIANT := $(BUILD_VARIANT)-san
endif
BUILD   ?= $(SRCDIR)/build/$(ARCH)$(BUILD_VARIANT)
BINDIR  ?= $(BUILD)/bin
OBJ_X11 ?= $(BUILD)/x11
OBJ_GL  ?= $(BUILD)/gl

# Optimised release flags (software + GL)
# -fno-strict-aliasing: Quake type-puns heavily
# -fcommon: tolerate legacy tentative defs if any remain
OPTFLAGS ?= -O3 -ffast-math -funroll-loops -fomit-frame-pointer \
            -fno-strict-aliasing $(MARCH)

WARNFLAGS ?= -Wall -Wno-unused-parameter -Wno-unused-variable \
             -Wno-missing-field-initializers -Wno-pointer-sign \
             -Wno-unused-but-set-variable -Wno-maybe-uninitialized \
             -Wno-stringop-truncation -Wno-format-truncation \
             -Wno-implicit-function-declaration -Wno-int-conversion \
             -Wno-incompatible-pointer-types -Wno-return-type \
             -Wno-discarded-qualifiers

# -fcommon: original Quake used tentative BSS defs in headers (pre-gcc-10 default)
BASE_CFLAGS := $(STD) $(OPTFLAGS) $(WARNFLAGS) -fcommon \
               -Dstricmp=strcasecmp -D_GNU_SOURCE \
               -I$(SRCDIR)

# Debug: full symbols, asserts on, Quake PARANOID checks, no NDEBUG.
# Usage: make -f Makefile.linux DEBUG=1 quake.x11
#        make -f Makefile.linux debug-x11
ifdef DEBUG
  # -fwrapv: software renderer uses intentional signed wrap (fixed-point)
  BASE_CFLAGS := $(STD) -O0 -g3 -fno-strict-aliasing -fno-omit-frame-pointer \
                 -fno-optimize-sibling-calls -fstack-protector-strong -fwrapv \
                 $(WARNFLAGS) -fcommon \
                 -Dstricmp=strcasecmp -D_GNU_SOURCE -I$(SRCDIR) \
                 -DDEBUG -DPARANOID -UNDEBUG
endif

LDFLAGS ?= -Wl,--as-needed -Wl,-O1

# Sanitizers (gcc). Example: SANITIZE=address,undefined
# Usage: make -f Makefile.linux DEBUG=1 SANITIZE=address,undefined quake.x11
ifdef SANITIZE
  SAN_FLAGS := -fsanitize=$(SANITIZE) -fno-omit-frame-pointer
  ifneq (,$(findstring address,$(SANITIZE)))
    SAN_FLAGS += -fsanitize-address-use-after-scope
  endif
  BASE_CFLAGS += $(SAN_FLAGS)
  LDFLAGS += $(SAN_FLAGS)
endif

# ALSA for snd_linux.c (OSS /dev/dsp is gone on modern systems)
ALSA_LIBS := $(shell pkg-config --libs alsa 2>/dev/null)
ifeq ($(ALSA_LIBS),)
  ALSA_LIBS := -lasound
endif
ALSA_CFLAGS := $(shell pkg-config --cflags alsa 2>/dev/null)

X11_CFLAGS  := $(BASE_CFLAGS) $(ALSA_CFLAGS) -DX11
GL_CFLAGS   := $(BASE_CFLAGS) $(ALSA_CFLAGS) -DGLQUAKE

X11_LIBS := -lX11 -lXext -lXxf86dga $(ALSA_LIBS) -lm
GL_LIBS  := -lGL -lX11 -lXext -lXxf86dga -lXxf86vm -ldl $(ALSA_LIBS) -lm

# -----------------------------------------------------------------------------
# Source lists (pure C — id386=0 on x86_64; C fallbacks in tree)
# -----------------------------------------------------------------------------

COMMON_SRCS := \
	cl_demo.c cl_input.c cl_main.c cl_parse.c cl_tent.c \
	chase.c cmd.c common.c console.c crc.c cvar.c \
	host.c host_cmd.c keys.c menu.c mathlib.c \
	net_dgrm.c net_loop.c net_main.c net_vcr.c net_udp.c net_bsd.c \
	pr_cmds.c pr_edict.c pr_exec.c \
	sbar.c sv_main.c sv_phys.c sv_move.c sv_user.c \
	zone.c view.c wad.c world.c \
	cd_linux.c sys_linux.c \
	snd_dma.c snd_mem.c snd_mix.c snd_linux.c

SOFT_SRCS := \
	draw.c d_edge.c d_fill.c d_init.c d_modech.c d_part.c \
	d_polyse.c d_scan.c d_sky.c d_sprite.c d_surf.c d_vars.c d_zpoint.c \
	model.c nonintel.c \
	r_aclip.c r_alias.c r_bsp.c r_light.c r_draw.c r_efrag.c \
	r_edge.c r_misc.c r_main.c r_sky.c r_sprite.c r_surf.c r_part.c r_vars.c \
	screen.c \
	vid_x.c

GL_SRCS := \
	gl_draw.c gl_mesh.c gl_model.c gl_refrag.c gl_rlight.c gl_dynlights.c \
	gl_rmain.c gl_rmisc.c gl_rsurf.c gl_screen.c gl_test.c gl_warp.c \
	r_part.c \
	gl_vidlinuxglx.c

X11_SRCS := $(COMMON_SRCS) $(SOFT_SRCS)
GLX_SRCS := $(COMMON_SRCS) $(GL_SRCS)

X11_OBJS := $(addprefix $(OBJ_X11)/,$(X11_SRCS:.c=.o))
GLX_OBJS := $(addprefix $(OBJ_GL)/,$(GLX_SRCS:.c=.o))

# -----------------------------------------------------------------------------
# Default targets
# -----------------------------------------------------------------------------

all: $(BINDIR)/quake.x11 $(BINDIR)/glquake

quake.x11: $(BINDIR)/quake.x11
glquake:  $(BINDIR)/glquake

$(BINDIR)/quake.x11: $(X11_OBJS) | $(BINDIR)
	$(CC) $(X11_CFLAGS) -o $@ $(X11_OBJS) $(X11_LIBS) $(LDFLAGS)
	@echo "Built $@"

$(BINDIR)/glquake: $(GLX_OBJS) | $(BINDIR)
	$(CC) $(GL_CFLAGS) -o $@ $(GLX_OBJS) $(GL_LIBS) $(LDFLAGS)
	@echo "Built $@"

# Convenience copies at WinQuake/ and repo root
install: all
	cp -f $(BINDIR)/quake.x11 $(SRCDIR)/quake.x11
	cp -f $(BINDIR)/glquake   $(SRCDIR)/glquake
	cp -f $(BINDIR)/quake.x11 $(ROOTDIR)/quake.x11
	cp -f $(BINDIR)/glquake   $(ROOTDIR)/glquake
	@echo "Installed quake.x11 and glquake to $(SRCDIR) and $(ROOTDIR)"

# Debug / sanitizer convenience (X11 software only — see docs/DEBUGGING_X11.md)
# Note: recursive make sets its own BUILD/BINDIR; copy from that tree explicitly.
debug-x11:
	$(MAKE) -f Makefile.linux DEBUG=1 quake.x11
	cp -f $(SRCDIR)/build/$(ARCH)-dbg/bin/quake.x11 $(ROOTDIR)/quake.x11-dbg
	cp -f $(SRCDIR)/build/$(ARCH)-dbg/bin/quake.x11 $(SRCDIR)/quake.x11-dbg
	@echo "Installed $(ROOTDIR)/quake.x11-dbg (DEBUG=1, asserts/PARANOID on)"

sanitize-x11:
	$(MAKE) -f Makefile.linux DEBUG=1 SANITIZE=address,undefined quake.x11
	cp -f $(SRCDIR)/build/$(ARCH)-dbg-san/bin/quake.x11 $(ROOTDIR)/quake.x11-asan
	cp -f $(SRCDIR)/build/$(ARCH)-dbg-san/bin/quake.x11 $(SRCDIR)/quake.x11-asan
	@echo "Installed $(ROOTDIR)/quake.x11-asan (ASan+UBSan)"

# -----------------------------------------------------------------------------
# Compile rules
# -----------------------------------------------------------------------------

$(OBJ_X11)/%.o: $(SRCDIR)/%.c | $(OBJ_X11)
	$(CC) $(X11_CFLAGS) -c -o $@ $<

$(OBJ_GL)/%.o: $(SRCDIR)/%.c | $(OBJ_GL)
	$(CC) $(GL_CFLAGS) -c -o $@ $<

$(BINDIR) $(OBJ_X11) $(OBJ_GL):
	@mkdir -p $@

# -----------------------------------------------------------------------------
# Tests / verify
# -----------------------------------------------------------------------------

# Smoke: binaries exist, -h/-version style help via -? or just start+quit
# Full interactive play is via Xmux (see docs / agent sessions).
test tests: all
	@echo "== binary smoke =="
	test -x $(BINDIR)/quake.x11
	test -x $(BINDIR)/glquake
	@echo "== file(1) =="
	file $(BINDIR)/quake.x11 $(BINDIR)/glquake
	@echo "== ldd (shared deps) =="
	ldd $(BINDIR)/quake.x11 | head -20
	ldd $(BINDIR)/glquake | head -20
	@echo "== headless basedir check (expect quit) =="
	# -dedicated 1 runs server-only briefly; software needs display for client
	# Just verify --help-ish: unknown flag should not segfault before usage
	-$(BINDIR)/quake.x11 -basedir $(ROOTDIR) +quit 2>&1 | head -5 || true
	@echo "test: OK (binaries built; interactive proof via Xmux)"

# Debug-only smoke (does not require glquake). Use after: make debug-x11 / sanitize-x11
test-debug:
	@echo "== debug/sanitize binary smoke =="
	test -x $(BINDIR)/quake.x11
	file $(BINDIR)/quake.x11
	@echo "== symbols (expect not stripped) =="
	nm $(BINDIR)/quake.x11 2>/dev/null | head -3 || true
	@echo "test-debug: OK ($(BINDIR)/quake.x11)"

verify: test
	@echo "formal: not run (game engine; no CBMC model yet)"

# -----------------------------------------------------------------------------
# Clean
# -----------------------------------------------------------------------------

clean:
	rm -rf $(BUILD)
	rm -f $(SRCDIR)/quake.x11 $(SRCDIR)/glquake
	rm -f $(ROOTDIR)/quake.x11 $(ROOTDIR)/glquake

distclean: clean
	rm -rf $(SRCDIR)/build
